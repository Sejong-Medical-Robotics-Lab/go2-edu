  <gazebo>
    <plugin name="planar_move" filename="libgazebo_ros_planar_move.so">
      <ros>
        <remapping>cmd_vel:=/go2/_base_cmd</remapping>
        <remapping>odom:=/odom_gt</remapping>
      </ros>
      <update_rate>100</update_rate>
      <publish_rate>20</publish_rate>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>false</publish_odom_tf>
      <odometry_frame>odom_gt</odometry_frame>
      <robot_base_frame>base</robot_base_frame>
    </plugin>
    <plugin name="joint_states" filename="libgazebo_ros_joint_state_publisher.so">
      <update_rate>50</update_rate>
      <joint_name>FR_hip_joint</joint_name>
      <joint_name>FR_thigh_joint</joint_name>
      <joint_name>FR_calf_joint</joint_name>
      <joint_name>FL_hip_joint</joint_name>
      <joint_name>FL_thigh_joint</joint_name>
      <joint_name>FL_calf_joint</joint_name>
      <joint_name>RR_hip_joint</joint_name>
      <joint_name>RR_thigh_joint</joint_name>
      <joint_name>RR_calf_joint</joint_name>
      <joint_name>RL_hip_joint</joint_name>
      <joint_name>RL_thigh_joint</joint_name>
      <joint_name>RL_calf_joint</joint_name>
    </plugin>
    <plugin name="joint_pose_trajectory" filename="libgazebo_ros_joint_pose_trajectory.so">
      <ros>
        <remapping>set_joint_trajectory:=/go2/set_joint_trajectory</remapping>
      </ros>
      <update_rate>100</update_rate>
    </plugin>
  </gazebo>
  <gazebo reference="imu">
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <plugin name="imu_plugin" filename="libgazebo_ros_imu_sensor.so">
        <ros>
          <remapping>~/out:=/go2/imu</remapping>
        </ros>
        <frame_name>imu</frame_name>
        <initial_orientation_as_reference>false</initial_orientation_as_reference>
      </plugin>
    </sensor>
  </gazebo>
  <gazebo reference="lidar_link">
    <sensor name="l1_lidar" type="ray">
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <visualize>false</visualize>
      <ray>
        <scan>
          <horizontal>
            <samples>120</samples>
            <resolution>1</resolution>
            <min_angle>-3.141593</min_angle>
            <max_angle>3.141593</max_angle>
          </horizontal>
          <vertical>
            <samples>8</samples>
            <resolution>1</resolution>
            <min_angle>-1.221730</min_angle>
            <max_angle>0.436332</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.15</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
      </ray>
      <plugin name="lidar_plugin" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <remapping>~/out:=/go2/pointcloud</remapping>
        </ros>
        <output_type>sensor_msgs/PointCloud2</output_type>
        <frame_name>lidar_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>
</robot>
