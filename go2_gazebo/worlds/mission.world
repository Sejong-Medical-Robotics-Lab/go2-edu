<?xml version="1.0"?>
<!-- 미션 월드 — 8m x 8m 구역, 장애물 3개, waypoint 마커 3개.
     교재 4.5 도전 미션: 이 파일을 텍스트로 열어 각 모델의 <pose>를
     여러분의 월드 평면도 스케치와 대조해 보세요. <pose>는 "x y z r p y". -->
<sdf version="1.6">
  <world name="mission">
    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <!-- 구역 경계 벽 -->
    <model name="wall_north"><static>true</static>
      <pose>0 4.0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>8.0 0.1 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>8.0 0.1 0.5</size></box></geometry>
          <material><ambient>0.75 0.75 0.78 1</ambient><diffuse>0.75 0.75 0.78 1</diffuse></material></visual>
      </link></model>
    <model name="wall_south"><static>true</static>
      <pose>0 -4.0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>8.0 0.1 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>8.0 0.1 0.5</size></box></geometry>
          <material><ambient>0.75 0.75 0.78 1</ambient><diffuse>0.75 0.75 0.78 1</diffuse></material></visual>
      </link></model>
    <model name="wall_east"><static>true</static>
      <pose>4.0 0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.1 8.0 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.1 8.0 0.5</size></box></geometry>
          <material><ambient>0.75 0.75 0.78 1</ambient><diffuse>0.75 0.75 0.78 1</diffuse></material></visual>
      </link></model>
    <model name="wall_west"><static>true</static>
      <pose>-4.0 0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.1 8.0 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.1 8.0 0.5</size></box></geometry>
          <material><ambient>0.75 0.75 0.78 1</ambient><diffuse>0.75 0.75 0.78 1</diffuse></material></visual>
      </link></model>

    <!-- 장애물 박스 3개 -->
    <model name="box_a"><static>true</static>
      <pose>1.2 0.6 0.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.4 0.4 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.4 0.4 0.5</size></box></geometry>
          <material><ambient>0.85 0.35 0.25 1</ambient><diffuse>0.85 0.35 0.25 1</diffuse></material></visual>
      </link></model>
    <model name="box_b"><static>true</static>
      <pose>-0.8 1.6 0.30 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.4 0.6 0.6</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.4 0.6 0.6</size></box></geometry>
          <material><ambient>0.85 0.55 0.20 1</ambient><diffuse>0.85 0.55 0.20 1</diffuse></material></visual>
      </link></model>
    <model name="box_c"><static>true</static>
      <pose>0.4 -1.5 0.20 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.5 0.4 0.4</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.5 0.4 0.4</size></box></geometry>
          <material><ambient>0.80 0.30 0.45 1</ambient><diffuse>0.80 0.30 0.45 1</diffuse></material></visual>
      </link></model>

    <!-- waypoint 마커(바닥 테이프 — 충돌 없음, 시각 전용) -->
    <model name="wp1"><static>true</static>
      <pose>2.2 1.6 0.003 0 0 0</pose>
      <link name="link"><visual name="v">
        <geometry><cylinder><radius>0.25</radius><length>0.005</length></cylinder></geometry>
        <material><ambient>0.2 0.7 0.3 1</ambient><diffuse>0.2 0.7 0.3 1</diffuse></material>
      </visual></link></model>
    <model name="wp2"><static>true</static>
      <pose>-1.8 2.4 0.003 0 0 0</pose>
      <link name="link"><visual name="v">
        <geometry><cylinder><radius>0.25</radius><length>0.005</length></cylinder></geometry>
        <material><ambient>0.2 0.5 0.8 1</ambient><diffuse>0.2 0.5 0.8 1</diffuse></material>
      </visual></link></model>
    <model name="wp3"><static>true</static>
      <pose>-1.2 -2.0 0.003 0 0 0</pose>
      <link name="link"><visual name="v">
        <geometry><cylinder><radius>0.25</radius><length>0.005</length></cylinder></geometry>
        <material><ambient>0.8 0.7 0.2 1</ambient><diffuse>0.8 0.7 0.2 1</diffuse></material>
      </visual></link></model>
  </world>
</sdf>
